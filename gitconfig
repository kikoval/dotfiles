[core]
	editor = vim
[merge]
	tool = vimdiff
[color]
	ui = true
[alias]
        branch = branch --sort=-committerdate
        br = branch -a
        brloc = !git branch -vv | cut -c 3- | awk '$3 !~/\\[/ { print $1 }' # non-tracking local branches
        brd = branch -D
        brdR = push origin --delete # delete remote branch
        s = status -u -s
        st = status
        ci = commit
        co = checkout
        cob = checkout -b
        redocommit = reset --soft HEAD^
        unstage = reset -- HEAD
        pl = pull
        ph = push
        lg = log -p --graph
        l1 = log --oneline --decorate
        l2 = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

[include]
        path = .gitconfig.local

[push]
	default = simple

[submodule]
        recurse = true
[init]
	defaultBranch = main
[filter "lfs"]
	process = git-lfs filter-process
	required = true
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
